{
  "name": "voxops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch apps/server/src/index.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.5",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.23.0"
}
